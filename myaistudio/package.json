{
  "name": "myaistudio-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test --test-timeout=15000 test/*.test.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "demos": "python3 scripts/make-demos.py",
    "audit": "node scripts/audit.mjs",
    "test:all": "npm test && npm run test:browser && npm run audit"
  },
  "dependencies": {
    "stripe": "^23.2.0"
  },
  "devDependencies": {
    "playwright": "^1.65.1"
  }
}
